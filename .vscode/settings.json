{
  // what to exclude in explorer
  "files.exclude": {
    "out": false, // set this to true to hide the "out" folder with the compiled JS files
    "dist": false, // set this to true to hide the "dist" folder with the compiled JS files
    "node_modules": true // set this to false to include "node_modules" folder in search results
  },

  // what to exclude in search
  "search.exclude": {
    "out": true,
    "dist": true,
    "node_modules": true // set this to false to include "node_modules" folder in search results
  },

  // disable running tsc automatically
  // "js/ts.tsc.autoDetect": "off",

  // run prettier when save
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // run eslint fix when save
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // prettier settings
  "prettier.endOfLine": "lf",
  "prettier.printWidth": 120,
  "prettier.requireConfig": true,
  "prettier.semi": false,
  "prettier.singleQuote": true,

  // disable python's type checking and problem reporting (sometimes it will report errors in JS/TS files)
  "python.analysis.typeCheckingMode": "off",

  // approved chat tools
  "chat.tools.terminal.autoApprove": {
    "/^pnpm run format:check$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^pnpm run lint$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^pnpm run check-types$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^pnpm exec eslint src$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^pnpm run compile$/": {
      "approve": true,
      "matchCommandLine": true
    }
  }
}
