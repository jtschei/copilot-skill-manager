// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": {
        "base": "$tsc",
        "applyTo": "allDocuments"
      },
      "label": "npm: compile"
    },
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": {
        "base": "$tsc-watch",
        "background": {
          "activeOnStart": false,
          "beginsPattern": {
            "regexp": "File change detected"
          },
          "endsPattern": {
            "regexp": "Watching for file changes"
          }
        },
        "owner": "watch",
        "applyTo": "allDocuments",
        "fileLocation": ["relative", "${workspaceFolder}"]
      },
      "group": "build",
      "presentation": {
        "reveal": "never",
        "revealProblems": "never",
        "focus": false,
        "echo": true,
        "showReuseMessage": false,
        "panel": "dedicated",
        "clear": false,
        "close": false,
        "group": "build"
      },
      "label": "npm: watch",
      "isBackground": true
    }
  ]
}
